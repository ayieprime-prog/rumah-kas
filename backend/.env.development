# ============= DEVELOPMENT ENVIRONMENT =============

# Database (Local PostgreSQL atau Railway dev)
DATABASE_URL="postgresql://user:password@localhost:5432/rumah_kas_dev"

# JWT (Development secret - dapat diganti)
JWT_SECRET="dev-secret-key-at-least-32-characters-long-for-testing"
JWT_EXPIRES_IN="12h"

# Server
NODE_ENV="development"
PORT=5000

# CORS (Localhost only)
CORS_ORIGIN="http://localhost:3000"

# Logging (Verbose for development)
LOG_LEVEL="debug"

# API
API_BASE_URL="http://localhost:5000"
