{
  "openapi": "3.0.0",
  "info": {
    "title": "RumahKas/Pundi API",
    "description": "Family Financial Management API - Personal & Household Finance Tracking",
    "version": "1.0.0",
    "contact": {
      "name": "RumahKas Team",
      "url": "https://rumah-kas-development.up.railway.app"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Development server"
    },
    {
      "url": "https://rumah-kas-development.up.railway.app",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Authentication", "description": "Auth & user management" },
    { "name": "Dashboard", "description": "Dashboard overview & summary" },
    { "name": "Household", "description": "Household members & profiles" },
    { "name": "Finances", "description": "Income, Expenses, Budget" },
    { "name": "Assets", "description": "Wallets, Assets, Transfers" },
    { "name": "Goals", "description": "Savings goals & targets" },
    { "name": "Debt", "description": "Debt tracking & management" },
    { "name": "Reports", "description": "Analytics & Reports" },
    { "name": "Planning", "description": "Budget allocation & analytics" },
    { "name": "Lifestyle", "description": "Maintenance, Journal, Events" },
    { "name": "Management", "description": "Links, Notifications, Activity" }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register new user",
        "description": "Create a new user account with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 },
                  "firstName": { "type": "string" }
                },
                "required": ["email", "password", "firstName"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Invalid input or user already exists" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login user",
        "description": "Authenticate user and receive session cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout user",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Logout successful" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get current user",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Current user data" },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get dashboard data",
        "description": "Retrieve overview, wallets, budgets, goals, debt summary",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "description": "Month (YYYY-MM format)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Dashboard data" },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/api/household": {
      "get": {
        "tags": ["Household"],
        "summary": "Get household members",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of household members" }
        }
      },
      "post": {
        "tags": ["Household"],
        "summary": "Add household member",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "role": { "type": "string", "enum": ["ADMIN", "MEMBER"] }
                },
                "required": ["firstName"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Member added" }
        }
      }
    },
    "/api/expenses": {
      "get": {
        "tags": ["Finances"],
        "summary": "List expenses",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": { "type": "string", "enum": ["FAMILY", "PERSONAL"] }
          }
        ],
        "responses": {
          "200": { "description": "List of expenses" }
        }
      },
      "post": {
        "tags": ["Finances"],
        "summary": "Create expense",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "number" },
                  "category": { "type": "string" },
                  "date": { "type": "string", "format": "date" },
                  "note": { "type": "string" },
                  "scope": { "type": "string", "enum": ["FAMILY", "PERSONAL"] }
                },
                "required": ["amount", "category", "date"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Expense created" }
        }
      }
    },
    "/api/expenses/{id}": {
      "put": {
        "tags": ["Finances"],
        "summary": "Update expense",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "Expense updated" }
        }
      },
      "delete": {
        "tags": ["Finances"],
        "summary": "Delete expense",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Expense deleted" }
        }
      }
    },
    "/api/income": {
      "get": {
        "tags": ["Finances"],
        "summary": "List income",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "List of income" }
        }
      },
      "post": {
        "tags": ["Finances"],
        "summary": "Create income",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "number" },
                  "source": { "type": "string" },
                  "date": { "type": "string", "format": "date" }
                },
                "required": ["amount", "source", "date"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Income created" }
        }
      }
    },
    "/api/budget": {
      "get": {
        "tags": ["Finances"],
        "summary": "List budgets",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "List of budgets" }
        }
      },
      "post": {
        "tags": ["Finances"],
        "summary": "Create budget",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": { "type": "string" },
                  "limit": { "type": "number" },
                  "month": { "type": "string" }
                },
                "required": ["category", "limit", "month"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Budget created" }
        }
      }
    },
    "/api/goals": {
      "get": {
        "tags": ["Goals"],
        "summary": "List savings goals",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of goals" }
        }
      },
      "post": {
        "tags": ["Goals"],
        "summary": "Create savings goal",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "targetAmount": { "type": "number" },
                  "targetDate": { "type": "string", "format": "date" },
                  "category": { "type": "string" }
                },
                "required": ["name", "targetAmount"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Goal created" }
        }
      }
    },
    "/api/debt": {
      "get": {
        "tags": ["Debt"],
        "summary": "List debts",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of debts" }
        }
      },
      "post": {
        "tags": ["Debt"],
        "summary": "Create debt record",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "creditor": { "type": "string" },
                  "amount": { "type": "number" },
                  "dueDate": { "type": "string", "format": "date" }
                },
                "required": ["creditor", "amount"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Debt created" }
        }
      }
    },
    "/api/wallets": {
      "get": {
        "tags": ["Assets"],
        "summary": "List wallets",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of wallets" }
        }
      },
      "post": {
        "tags": ["Assets"],
        "summary": "Create wallet",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "balance": { "type": "number" },
                  "icon": { "type": "string" },
                  "type": { "type": "string", "enum": ["CASH", "BANK", "DIGITAL"] }
                },
                "required": ["name", "balance"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Wallet created" }
        }
      }
    },
    "/api/assets": {
      "get": {
        "tags": ["Assets"],
        "summary": "List assets",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of assets" }
        }
      },
      "post": {
        "tags": ["Assets"],
        "summary": "Create asset",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "number" },
                  "type": { "type": "string" },
                  "notes": { "type": "string" }
                },
                "required": ["name", "value"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Asset created" }
        }
      }
    },
    "/api/transfers": {
      "get": {
        "tags": ["Assets"],
        "summary": "List transfers",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of transfers" }
        }
      },
      "post": {
        "tags": ["Assets"],
        "summary": "Create transfer",
        "description": "Transfer money between wallets",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fromWalletId": { "type": "string" },
                  "toWalletId": { "type": "string" },
                  "amount": { "type": "number" },
                  "note": { "type": "string" }
                },
                "required": ["fromWalletId", "toWalletId", "amount"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Transfer created" }
        }
      }
    },
    "/api/transfers/{id}/approve": {
      "put": {
        "tags": ["Assets"],
        "summary": "Approve transfer",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Transfer approved" }
        }
      }
    },
    "/api/transfers/{id}/reject": {
      "put": {
        "tags": ["Assets"],
        "summary": "Reject transfer",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Transfer rejected" }
        }
      }
    },
    "/api/reports": {
      "get": {
        "tags": ["Reports"],
        "summary": "Get financial reports",
        "description": "Monthly & category breakdowns, trends",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["monthly", "yearly", "category"] }
          }
        ],
        "responses": {
          "200": { "description": "Financial reports" }
        }
      }
    },
    "/api/budget-analytics": {
      "get": {
        "tags": ["Planning"],
        "summary": "Get budget analytics",
        "description": "Detailed spending analysis by category",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Budget analytics" }
        }
      }
    },
    "/api/allocation": {
      "get": {
        "tags": ["Planning"],
        "summary": "Get allocation",
        "description": "Monthly budget allocation overview",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Allocation data" }
        }
      }
    },
    "/api/maintenance": {
      "get": {
        "tags": ["Lifestyle"],
        "summary": "List maintenance tasks",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of maintenance tasks" }
        }
      },
      "post": {
        "tags": ["Lifestyle"],
        "summary": "Create maintenance task",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "item": { "type": "string" },
                  "dueDate": { "type": "string", "format": "date" },
                  "estimatedCost": { "type": "number" }
                },
                "required": ["title", "item"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Maintenance created" }
        }
      }
    },
    "/api/journal": {
      "get": {
        "tags": ["Lifestyle"],
        "summary": "List journal entries",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of journal entries" }
        }
      },
      "post": {
        "tags": ["Lifestyle"],
        "summary": "Create journal entry",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "content": { "type": "string" },
                  "date": { "type": "string", "format": "date" }
                },
                "required": ["title", "content"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Journal entry created" }
        }
      }
    },
    "/api/links": {
      "get": {
        "tags": ["Management"],
        "summary": "List important links",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of important links" }
        }
      },
      "post": {
        "tags": ["Management"],
        "summary": "Create link",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "url": { "type": "string", "format": "uri" },
                  "category": { "type": "string" }
                },
                "required": ["title", "url"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Link created" }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": ["Management"],
        "summary": "List notifications",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of notifications" }
        }
      }
    },
    "/api/activity": {
      "get": {
        "tags": ["Management"],
        "summary": "Get activity log",
        "description": "User activity history and audit log",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer" }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Activity log" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionId"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
