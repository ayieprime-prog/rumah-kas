// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= HOUSEHOLD & AUTH =============
model Household {
  id        String   @id @default(cuid())
  name      String   // e.g., "Rumah Keluarga Budi"
  currency  String   @default("IDR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  expenses       Expense[]
  incomes        Income[]
  budgets        Budget[]
  goals          Goal[]
  debts          Debt[]
  recurring      RecurringExpense[]
  categories     ExpenseCategory[]
  wallets        Wallet[]
  notifications  Notification[]
  importantLinks ImportantLink[]
  maintenanceItems MaintenanceItem[]
  events         Event[]
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]

  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hashed
  name      String
  role      UserRole @default(MEMBER) // ADMIN (creator), MEMBER (spouse)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([email])
}

enum UserRole {
  ADMIN   // Pembuat akun / pemilik utama
  MEMBER  // Anggota (suami/istri)
}

// ============= EXPENSES & INCOME =============
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("wallet")
  color     String   @default("#FF6B6B")

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  expenses  Expense[]
  budgets   Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
  @@index([householdId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime

  householdId       String
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  walletId    String?
  wallet      Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  isRecurring Boolean @default(false)
  recurringId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([categoryId])
  @@index([walletId])
  @@index([date])
}

model Income {
  id          String   @id @default(cuid())
  source      String   // e.g., "Gaji Suami", "Passive Income", etc
  amount      Float
  date        DateTime

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  walletId    String?
  wallet      Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  isRecurring Boolean @default(false)
  recurringId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([walletId])
  @@index([date])
}

model RecurringExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  frequency   String   // "DAILY", "WEEKLY", "MONTHLY", "YEARLY"
  startDate   DateTime
  endDate     DateTime? // null = indefinite

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= BUDGETING & GOALS =============
model Budget {
  id          String   @id @default(cuid())
  month       String   // "2026-09" format
  limit       Float
  spent       Float    @default(0)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, month, categoryId])
  @@index([householdId])
  @@index([month])
}

model Goal {
  id          String   @id @default(cuid())
  name        String   // e.g., "Liburan ke Bali", "Mobil Baru"
  targetAmount Float
  currentAmount Float @default(0)
  targetDate  DateTime
  description String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([targetDate])
}

// ============= DEBT MANAGEMENT =============
model Debt {
  id          String   @id @default(cuid())
  name        String   // e.g., "Cicilan Rumah", "Pinjam Teman"
  totalAmount Float
  paidAmount  Float    @default(0)
  monthlyPayment Float
  startDate   DateTime
  endDate     DateTime? // estimated
  creditor    String?   // e.g., "Bank XYZ", "Teman Budi"

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= WALLET MANAGEMENT =============
model Wallet {
  id        String   @id @default(cuid())
  name      String   // e.g., "Tunai", "BCA", "Dompet Digital"
  type      String   @default("CASH") // CASH, BANK_ACCOUNT, DIGITAL_WALLET
  balance   Float    @default(0)
  icon      String   @default("wallet")
  isActive  Boolean  @default(true)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  expenses    Expense[]
  incomes     Income[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= NOTIFICATIONS & ALERTS =============
model Notification {
  id        String   @id @default(cuid())
  type      String   // "BUDGET_EXCEEDED", "GOAL_REACHED", "DEBT_PAYMENT_DUE"
  message   String
  read      Boolean  @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([householdId])
  @@index([read])
}

// ============= AUDIT LOG =============
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "CREATE_EXPENSE", "DELETE_BUDGET", etc
  entity    String   // "EXPENSE", "BUDGET", "GOAL"
  entityId  String
  summary   String   // short human-readable description, e.g. "Belanja bulanan - Rp500.000"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([householdId])
}

model MaintenanceItem {
  id           String   @id @default(cuid())
  name         String   // "Mobil Avanza", "AC Ruang Tamu"
  type         String   // VEHICLE | HOME
  intervalDays Int?     // e.g. every 90 days for oil change
  lastServiceDate DateTime?
  nextDueDate     DateTime?
  notes        String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  logs        MaintenanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  serviceDate DateTime
  cost        Float?
  notes       String?

  maintenanceItemId String
  maintenanceItem   MaintenanceItem @relation(fields: [maintenanceItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([maintenanceItemId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  content   String
  mood      String?  // emoji tag, e.g. "😊", "😔", "😴"
  entryDate DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([entryDate])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  allDay      Boolean  @default(true)
  category    String?  // "Sekolah", "Dokter", "Acara Keluarga"

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([startDate])
}

// ============= HOUSEHOLD EXTRAS =============
model ImportantLink {
  id       String  @id @default(cuid())
  title    String  // "Kartu Keluarga", "Polis Asuransi"
  url      String
  category String? // "Dokumen Legal", "Asuransi", "Sertifikat"
  notes    String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}
