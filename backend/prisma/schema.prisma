// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= HOUSEHOLD & AUTH =============
model Household {
  id        String   @id @default(cuid())
  name      String   // e.g., "Rumah Keluarga Budi"
  currency  String   @default("IDR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  expenses       Expense[]
  incomes        Income[]
  budgets        Budget[]
  goals          Goal[]
  debts          Debt[]
  recurring      RecurringExpense[]
  categories     ExpenseCategory[]
  notifications  Notification[]
  wallets        Wallet[]
  transfers      Transfer[]
  assets         Asset[]
  auditLogs      AuditLog[]
  events         Event[]
  importantLinks ImportantLink[]
  journalEntries JournalEntry[]
  maintenanceItems MaintenanceItem[]

  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hashed
  name      String
  role      UserRole @default(MEMBER) // ADMIN (creator), MEMBER (spouse)
  wallpaper String?  // data URI (base64) untuk background dashboard pribadi
  city       String?  // nama kota untuk widget cuaca (diisi via deteksi otomatis atau cari manual)
  weatherLat Float?   // koordinat tersimpan supaya dashboard tidak perlu minta izin GPS tiap kali
  weatherLon Float?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  auditLogs      AuditLog[]
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([email])
}

enum UserRole {
  ADMIN   // Pembuat akun / pemilik utama
  MEMBER  // Anggota (suami/istri)
}

// ============= EXPENSES & INCOME =============
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("wallet")
  color     String   @default("#FF6B6B")

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  expenses  Expense[]
  budgets   Budget[]
  lockedIncomes Income[] @relation("IncomeLock")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
  @@index([householdId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime

  householdId       String
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  walletId    String?
  wallet      Wallet? @relation(fields: [walletId], references: [id])

  isRecurring Boolean @default(false)
  recurringId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([categoryId])
  @@index([walletId])
  @@index([date])
}

model Income {
  id          String   @id @default(cuid())
  source      String   // e.g., "Gaji Suami", "Passive Income", etc
  amount      Float
  date        DateTime

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  walletId    String?
  wallet      Wallet? @relation(fields: [walletId], references: [id])

  // Kalau diisi, pendapatan ini "dikunci" untuk kategori pengeluaran
  // tertentu (mis. gaji dikunci untuk "Rumah Tangga") -- dipakai untuk
  // menghitung sisa alokasi terkunci per kategori per bulan, terpisah
  // dari Uang Bebas. Lihat utils/incomeLock.js.
  lockedCategoryId String?
  lockedCategory   ExpenseCategory? @relation("IncomeLock", fields: [lockedCategoryId], references: [id])

  isRecurring Boolean @default(false)
  recurringId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([walletId])
  @@index([date])
  @@index([lockedCategoryId])
}

model RecurringExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  frequency   String   // "DAILY", "WEEKLY", "MONTHLY", "YEARLY"
  startDate   DateTime
  endDate     DateTime? // null = indefinite

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= BUDGETING & GOALS =============
model Budget {
  id          String   @id @default(cuid())
  month       String   // "2026-09" format
  limit       Float
  spent       Float    @default(0)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, month, categoryId])
  @@index([householdId])
  @@index([month])
}

model Goal {
  id          String   @id @default(cuid())
  name        String   // e.g., "Liburan ke Bali", "Mobil Baru"
  targetAmount Float
  currentAmount Float @default(0)
  targetDate  DateTime
  description String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([targetDate])
}

// ============= DEBT MANAGEMENT =============
model Debt {
  id          String   @id @default(cuid())
  name        String   // e.g., "Cicilan Rumah", "Pinjam Teman"
  totalAmount Float
  paidAmount  Float    @default(0)
  monthlyPayment Float
  startDate   DateTime
  endDate     DateTime? // estimated
  creditor    String?   // e.g., "Bank XYZ", "Teman Budi"

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= NOTIFICATIONS & ALERTS =============
model Notification {
  id        String   @id @default(cuid())
  type      String   // "BUDGET_EXCEEDED", "GOAL_REACHED", "DEBT_PAYMENT_DUE"
  message   String
  read      Boolean  @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([householdId])
  @@index([read])
}

// ============= WALLET MANAGEMENT =============
model Wallet {
  id        String   @id @default(cuid())
  name      String   // e.g., "Tunai", "BCA", "Dompet Digital"
  type      String   @default("CASH") // CASH, BANK_ACCOUNT, DIGITAL_WALLET
  balance   Float    @default(0)
  icon      String   @default("wallet")
  isActive  Boolean  @default(true)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  expenses      Expense[]
  incomes       Income[]
  transfersFrom Transfer[] @relation("fromWallet")
  transfersTo   Transfer[] @relation("toWallet")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= TRANSFER MANAGEMENT =============
model Transfer {
  id        String   @id @default(cuid())
  amount    Float
  note      String?
  status    TransferStatus @default(PENDING) // PENDING, APPROVED, REJECTED, COMPLETED

  fromWalletId String
  fromWallet   Wallet @relation("fromWallet", fields: [fromWalletId], references: [id], onDelete: Cascade)

  toWalletId   String
  toWallet     Wallet @relation("toWallet", fields: [toWalletId], references: [id], onDelete: Cascade)

  initiatedById String? // null = auto transfer (same user)
  recipientId   String? // if transfer to another household member

  approvedBy    String? // who approved the transfer
  approvedAt    DateTime?

  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([status])
  @@index([fromWalletId])
  @@index([toWalletId])
}

enum TransferStatus {
  PENDING    // Waiting for approval (if multi-user)
  APPROVED   // Approved but not yet executed
  REJECTED   // Transfer was rejected
  COMPLETED  // Transfer completed successfully
}

// ============= ASSET MANAGEMENT =============
model Asset {
  id              String   @id @default(cuid())
  name            String   // e.g., "Rumah di Bekasi", "Toyota Avanza"
  type            AssetType // REAL_ESTATE, VEHICLE, JEWELRY, ART, CRYPTOCURRENCY, CASH_ALTERNATIVE, OTHER
  description     String?
  currentValue    Float    // current valuation in household currency
  purchasePrice   Float?   // original purchase price
  purchaseDate    DateTime?
  currency        String   @default("IDR")
  location        String?  // for real estate
  notes           String?

  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  valuations      AssetValuation[] // historical valuations for trend tracking

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([householdId])
  @@index([type])
}

model AssetValuation {
  id        String   @id @default(cuid())
  value     Float    // valuation at this point in time
  date      DateTime @default(now())

  assetId   String
  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([date])
}

enum AssetType {
  REAL_ESTATE        // Tanah, Rumah, Apartemen
  VEHICLE           // Mobil, Motor, Sepeda
  JEWELRY           // Emas, Berlian, Logam Mulia
  ART               // Lukisan, Barang Antik
  CRYPTOCURRENCY    // Bitcoin, Ethereum, dll
  CASH_ALTERNATIVE  // Deposito, Obligasi, Reksa Dana
  OTHER             // Lainnya
}

// ============= AUDIT LOG =============
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "CREATE_EXPENSE", "UPDATE_BUDGET", etc
  entity      String   // "EXPENSE", "BUDGET", "GOAL"
  entityId    String
  summary     String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([householdId])
}

// ============= KALENDER =============
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  allDay      Boolean  @default(true)
  category    String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([startDate])
}

// ============= LINK PENTING =============
model ImportantLink {
  id       String  @id @default(cuid())
  title    String
  url      String
  category String?
  notes    String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

// ============= JURNAL KELUARGA =============
model JournalEntry {
  id        String   @id @default(cuid())
  content   String
  mood      String?
  entryDate DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([entryDate])
}

// ============= MAINTENANCE (SERVIS KENDARAAN & RUMAH) =============
model MaintenanceItem {
  id              String    @id @default(cuid())
  name            String
  type            String
  intervalDays    Int?
  lastServiceDate DateTime?
  nextDueDate     DateTime?
  notes           String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  logs MaintenanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  serviceDate DateTime
  cost        Float?
  notes       String?

  maintenanceItemId String
  maintenanceItem   MaintenanceItem @relation(fields: [maintenanceItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([maintenanceItemId])
}
