# ============= PRODUCTION ENVIRONMENT =============
# ⚠️ NEVER commit this file with real values to Git!
# Use Railway Variables panel for actual production values

# Database (Railway PostgreSQL)
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# JWT (MUST be strong random string 32+ chars)
JWT_SECRET="your-production-secret-key-at-least-32-characters-must-be-very-secure"
JWT_EXPIRES_IN="12h"

# Server
NODE_ENV="production"
PORT=3000

# CORS (Production domain only)
CORS_ORIGIN="https://rumah-kas-production.up.railway.app"

# Logging (Minimal for production)
LOG_LEVEL="warn"

# API
API_BASE_URL="https://rumah-kas-production.up.railway.app"

# Error Tracking (Optional but recommended)
# SENTRY_DSN="https://key@sentry.io/projectid"

# Email (For real notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="noreply@rumahkas.id"

# Payment Gateway (Phase 3)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
